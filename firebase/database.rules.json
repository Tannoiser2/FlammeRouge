{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('host').val() === auth.uid && !newData.exists()",
        ".validate": "$code.length === 4",
        "host": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "created": {
          ".write": "auth != null && !data.exists()"
        },
        "status": {
          ".write": "auth != null && newData.parent().child('host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "open": {
          ".write": "auth != null && newData.parent().child('host').val() === auth.uid"
        },
        "game": {
          ".write": "auth != null && newData.parent().child('host').val() === auth.uid"
        },
        "seats": {
          "$i": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid || data.child('away').val() === true || root.child('rooms/' + $code + '/host').val() === auth.uid || newData.parent().parent().child('host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid', 'name']) && newData.child('name').isString() && newData.child('name').val().length <= 24"
          }
        },
        "turns": {
          "$r": {
            "$t": {
              ".write": "auth != null && !data.exists() && (root.child('rooms/' + $code + '/seats/' + $t + '/uid').val() === auth.uid || root.child('rooms/' + $code + '/host').val() === auth.uid)"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
